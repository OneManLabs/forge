# Add the key for every provider used by your configured tiers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================
# Provider-neutral tier routing
# ============================================================
#
# Forge routes each phase independently:
#   DESIGN → visual direction, variations, plans, redesigns
#   CODE   → complete multi-file implementation
#   EDIT   → focused pin, copy, and component edits
#
# The easiest configuration uses provider:model-id references. Model IDs are
# intentionally not restricted, so new GPT or Claude releases can be selected
# without a code change.

# ----- Default Claude mix -----
# FORGE_DESIGN_MODEL=anthropic:claude-opus-4-7
# FORGE_CODE_MODEL=anthropic:claude-sonnet-4-6
# FORGE_EDIT_MODEL=anthropic:claude-haiku-4-5

# ----- All OpenAI -----
# FORGE_DESIGN_MODEL=openai:gpt-5.6
# FORGE_CODE_MODEL=openai:gpt-5.6
# FORGE_EDIT_MODEL=openai:gpt-5.6

# ----- Mixed providers -----
# FORGE_DESIGN_MODEL=anthropic:claude-opus-4-7
# FORGE_CODE_MODEL=openai:gpt-5.6
# FORGE_EDIT_MODEL=anthropic:claude-haiku-4-5

# Alternatively, configure the provider and model separately:
# FORGE_DESIGN_PROVIDER=openai
# FORGE_DESIGN_MODEL=gpt-5.6
# FORGE_CODE_PROVIDER=anthropic
# FORGE_CODE_MODEL=claude-sonnet-4-6

# A global provider applies to tiers without a tier-specific provider.
# FORGE_PROVIDER=openai

# Legacy single-model override remains supported. The provider is inferred
# from common GPT/Claude model IDs or can be set with FORGE_PROVIDER.
# FORGE_MODEL=gpt-5.6

# Optional per-tier controls. Omit effort for maximum compatibility with
# arbitrary model IDs. Valid values: low, medium, high, none.
# FORGE_DESIGN_EFFORT=high
# FORGE_CODE_EFFORT=medium
# FORGE_EDIT_EFFORT=none
# FORGE_DESIGN_MAX_TOKENS=64000
# FORGE_CODE_MAX_TOKENS=64000
# FORGE_EDIT_MAX_TOKENS=16000
